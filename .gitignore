# vtysh writes a backup beside the config it replaces. A Lab Example's seed
# is the config, not its history, and the copy handed to a Group is the whole
# directory — backups would ride along.
*.sav

# A Seed holds only frr.conf. A Router renders its other FRR files from its
# Protocols on every start, which in CLI Mode lands them in the Seed itself.
frr-config/**/daemons
frr-config/**/vtysh.conf
frr-config/**/support_bundle_commands.conf

# Assignments the Instructor edits in the web UI, saved beside .env
assignments.json

# Logins the Instructor adds in the web UI, with their passwords in plain text
accounts.json

# Limits the Instructor changes in the web UI's Server settings
settings.json

# Each Group's copies of Persistent Config, seeded from frr-config/ by the
# web UI's manager in Multi-Lab Mode
group-config/

# Instructor-authored Lab Example drafts and published recipes are local data.
authored-labs/
