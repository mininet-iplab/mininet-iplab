# ExaBGP configuration generated by mnIPLab for ${name}
# local-as: ${local_as if local_as else 'unset'}

<%def name="neighbor_block(neighbors, routes)">
% for n in neighbors:
neighbor ${n.peer} {
  router-id ${getattr(n, 'router_id', '1.1.1.1')};
  local-address ${n.local_address};
  local-as ${n.local_as};
  peer-as ${n.peer_as};
% if n.hold_time:
  hold-time ${n.hold_time};
% endif
  passive;
  listen 179;
<%
  # Determine address family (auto-detected in BGPNeighbor.__post_init__)
  family = getattr(n, 'address_family', 'ipv4')
%>\
  family {
    ${family} unicast;
  }
  static {
<%
  # Use per-neighbor routes if defined, otherwise fall back to global routes
  neighbor_routes = n.routes if n.routes else routes
%>\
% for r in neighbor_routes:
    route ${r.prefix} {
% if r.as_path:
      as-path [ ${' '.join(str(a) for a in r.as_path)} ];
% endif
% if r.community:
      community [ ${' '.join(r.community)} ];
% endif
% if r.large_community:
      large-community [ ${' '.join(r.large_community)} ];
% endif
% if r.med is not None:
      med ${r.med};
% endif
      next-hop ${r.next_hop};
    }
% endfor
  }
}

% endfor
</%def>

${neighbor_block(neighbors, routes)}
