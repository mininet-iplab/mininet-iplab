# mnIPLab Web Server Configuration
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Edit the .env file to change credentials and settings
# 3. Restart your lab to apply changes
#
# A Lab and the web server read .env from the working directory. To read
# another file instead -- two web servers from one checkout, say -- export
# MNIPLAB_ENV_FILE=<path> in the shell before starting; it cannot be set
# from inside the file it names. A shell export always wins over the file.
#
# NOTE: These defaults are defined in mniplab/webserver/config.py as:
# DEFAULT_HOST, DEFAULT_PORT, DEFAULT_USERNAME, DEFAULT_CORS_ORIGINS
#
# SECURITY WARNING:
# Without MNIPLAB_PASSWORD the server generates a random password at every
# start and prints it on the console. Set your own before sharing access.
# Set MNIPLAB_ENVIRONMENT=production to enable security warnings.
#
# ---------------------------------------------------------------------------
# SCENARIOS -- pick the block that matches your setup, uncomment it, and
# leave the rest of this file as it is. Every setting is explained further
# down. The server reads this file at startup: restart it after a change.
# ---------------------------------------------------------------------------
#
# 1. Self-study on your own machine (Single-Lab Mode, one login)
#    One account, every Lab Example, one Lab at a time. This is the default;
#    only the password needs setting.
#
# MNIPLAB_USERNAME=me
# MNIPLAB_PASSWORD=MyOwnPass1
#
# 2. A class that moves together (Single-Lab Mode, shared learner login)
#    The Instructor starts one Lab and everyone works in it. Learners share
#    one login, so keep the per-user Session cap OFF (0) or the class locks
#    itself out. `write memory` in a Lab Example with Persistent Config lands
#    in its frr-config/ directory, exactly as when run from a terminal.
#
# MNIPLAB_USERS=teacher:TeachPass1:instructor,class:ClassPass1:learner
# MNIPLAB_SESSION_PER_USER_CAP=0
#
# 3. Groups working at their own pace (Multi-Lab Mode, a login per table)
#    Each learner login is a Group with a Lab of its own; the Instructor
#    assigns each Group its Lab Examples from the dashboard (saved to
#    assignments.json beside this file) and can watch or stop any Lab. The
#    cap bounds alive Labs on the host, Instructor included. A Lab Example
#    with Persistent Config is the seed: each Group's first start copies it
#    to group-config/<group>/<example>/ and later starts resume that copy,
#    so `write memory` never reaches frr-config/. Author the seed from a
#    terminal (python3 examples/ospf-lab.py); Groups can "Start clean" and
#    the Instructor can reset any copy from the dashboard.
#
# MNIPLAB_USERS=teacher:TeachPass1:instructor,table1:Table1Pass:learner,table2:Table2Pass:learner,table3:Table3Pass:learner
# MNIPLAB_LAB_MODE=multi
# MNIPLAB_LAB_CAP=4
#
# 4. A shared or Internet-facing host (any mode, hardened)
#    Production mode refuses the default password and CORS wildcards, and
#    warns about weak settings. Restrict CORS to the address students use
#    and give every account a strong password.
#
# MNIPLAB_ENVIRONMENT=production
# MNIPLAB_HOST=0.0.0.0
# MNIPLAB_PORT=8050
# MNIPLAB_CORS_ORIGINS=["https://lab.example.edu"]
# MNIPLAB_USERS=teacher:Long-Instructor-Passphrase-1:instructor,table1:Long-Group-Passphrase-1:learner
# MNIPLAB_LAB_MODE=multi
# MNIPLAB_LOGIN_RATE_LIMIT=5
#
# Start the server with `python -m mniplab serve`; for scenarios 1 and 2
# `python3 examples/ospf-lab.py --enable-web` also works and gives you the
# Lab Prompt on your own terminal as well as in the browser.

# Server Settings
MNIPLAB_HOST=0.0.0.0
MNIPLAB_PORT=8050
MNIPLAB_ENABLE_WEB=true

# Authentication
# Leave MNIPLAB_PASSWORD commented out to get a random password at every
# start (printed on the console), or set your own: at least 8 characters,
# with a letter and a digit.
MNIPLAB_USERNAME=admin
# MNIPLAB_PASSWORD=

# Multi-user role-based access (optional, overrides USERNAME/PASSWORD when set)
# Format: comma-separated 'user:password:role' entries. Roles: instructor, learner
# Instructors can start/stop labs; learners can only observe and open terminals.
# Example:
# MNIPLAB_USERS=alice:InstructorPass1:instructor,bob:LearnerPass2:learner,carol:LearnerPass3:learner
# MNIPLAB_USERS=

# Lab mode (read at startup only -- change it and restart; the server comes
# up with no Lab alive)
#   single: one Lab for everyone (the default)
#   multi:  a Lab per Group. A Group is a login from MNIPLAB_USERS; it holds
#           one Lab at a time and sees only its own. The Instructor assigns
#           each Group its Lab Examples in the web UI, saved to
#           assignments.json beside this file, and sees every Lab.
# MNIPLAB_LAB_MODE=single
# The most Labs alive at once in Multi-Lab Mode, Instructor included
# MNIPLAB_LAB_CAP=4

# Session and terminal limits
#
# Operational hygiene, not security boundaries. Within a
# Lab, account credentials are not secret, and a Terminal already runs with
# full root privilege inside it; these four knobs bound resource use and
# accidental sprawl, nothing more.
#
# A Session survives for as long as it is actually used: Terminal traffic and
# any UI action both refresh it. A browser tab left open with neither -- no
# Terminal, no clicking -- is swept after MNIPLAB_SESSION_IDLE_TIMEOUT seconds.
#
# MNIPLAB_SESSION_PER_USER_CAP is OFF (0) by default. Turn it on only if every
# account here maps to one real person; with a credential shared across a
# class, a non-zero cap locks the class out, not just the extra devices.
MNIPLAB_SESSION_PER_USER_CAP=0      # Sessions per account (0 = off)
MNIPLAB_SESSION_IDLE_TIMEOUT=9000   # Seconds a Session may go unseen (2.5h)
MNIPLAB_TERMINAL_GLOBAL_CAP=100     # Max Terminals across the whole host
MNIPLAB_TERMINAL_PER_SESSION_CAP=5  # Max Terminals per Session (one browser)

# Every MNIPLAB_PTY_* name above and below still works for one release and
# warns on use: PTY_GLOBAL_CAP, PTY_PER_SESSION_CAP -- and before it
# PTY_PER_CLIENT_CAP -- PTY_IDLE_TIMEOUT and PTY_PING_INTERVAL. The vocabulary
# is Terminal; PTY named the OS mechanism, never the thing an operator tunes.

# Terminal keepalive, distinct from the Session limits above -- these bound
# one Terminal's own connection, not how many Sessions or Terminals exist
MNIPLAB_TERMINAL_IDLE_TIMEOUT=300   # Auto-disconnect a Terminal after N idle seconds
MNIPLAB_TERMINAL_PING_INTERVAL=15   # WebSocket keepalive ping interval

# Rate Limiting
MNIPLAB_LOGIN_RATE_LIMIT=5          # Wrong passwords per minute per login name
# A reload reopens a whole set of Terminals, so this must be at least three
# times TERMINAL_PER_SESSION_CAP or ordinary reloading trips the limiter. Only a
# connection that actually yields a Terminal is counted.
MNIPLAB_WS_RATE_LIMIT=30            # Terminal connections per minute per Session
# Attempts per minute counted whatever the outcome. Bounds a client asking
# repeatedly for something it will never be granted, which WS_RATE_LIMIT cannot,
# because not charging for refusals is the point of it. Must be >= WS_RATE_LIMIT.
MNIPLAB_WS_ATTEMPT_LIMIT=120         # Terminal connection attempts per minute per Session

# Private Namespace Nodes (escape hatch)
#
# Hosts and Routers get their own PID and UTS namespaces by default, so `ps`
# and `hostname` inside a Node show that Node and nothing else. This is a
# fidelity feature, not a security boundary; the Session and Terminal limits
# above still govern what a Terminal can reach.
#
# Setting this to 0 is NOT a supported deployment mode. It exists only so a
# Lab that breaks in front of a class can be un-broken without a rollback,
# and it is scheduled for removal once the feature has held through a full
# classroom delivery run. Do not build a deployment around it.
# MNIPLAB_PRIVATE_NAMESPACES=0

# CORS (for production, restrict to specific origins)
# MNIPLAB_CORS_ORIGINS=["https://yourdomain.com"]

# Environment Mode (optional)
# Set to 'production' to enable security configuration warnings
# Default is 'development' (no warnings, suitable for labs)
# MNIPLAB_ENVIRONMENT=development
